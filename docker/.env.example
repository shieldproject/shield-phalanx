# Docker tests use built-in RustFS for S3 storage — no credentials needed.
# Override only if connecting to external S3:
# S3_ENDPOINT=http://rustfs:9000
# AWS_ACCESS_KEY_ID=rustfsadmin
# AWS_SECRET_ACCESS_KEY=rustfsadmin

# SHIELD source branch (default: develop)
# SHIELD_BRANCH=develop

# SHIELD configuration (defaults shown - override if needed)
# SHIELD_CORE_MASTER=sekrit
